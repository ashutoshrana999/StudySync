PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/studysync
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://127.0.0.1:5500

# Static QR payload validation
STATIC_QR_SECRET=replace-with-static-qr-secret

# Dynamic QR uses HMAC(secret, timeSlice)
DYNAMIC_QR_SECRET=replace-with-dynamic-qr-secret
DYNAMIC_QR_WINDOW_SECONDS=30

# Email (optional) - used by Notification feature
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="StudySync <no-reply@studysync.local>"

